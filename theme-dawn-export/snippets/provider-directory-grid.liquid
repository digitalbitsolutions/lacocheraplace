{%- liquid
  assign service_directory_handles = 'lavado,detailing,neumaticos-y-llantas,ppf-wrap-tintado-lunas,chapa-y-pintura,mantenimiento-ligero,grua-y-auxlio-mecanico,parking,productos-usados-y-liquidaciones,renta-de-espacios-y-herramientas-para-automocion' | split: ','
  assign show_directory = false
  if service_directory_handles contains collection.handle
    assign show_directory = true
  endif

  assign provider_vendors_string = ''
  assign provider_vendor_keys = '|'

  if show_directory
    for product in collection.products
      assign provider_vendor_name = product.vendor | strip
      if provider_vendor_name != blank
        assign provider_vendor_token = '|' | append: provider_vendor_name | append: '|'
        unless provider_vendor_keys contains provider_vendor_token
          assign provider_vendor_keys = provider_vendor_keys | append: provider_vendor_name | append: '|'
          assign provider_vendors_string = provider_vendors_string | append: provider_vendor_name | append: '|||'
        endunless
      endif
    endfor
  endif

  assign provider_vendor_list = provider_vendors_string | split: '|||'
  assign provider_vendor_count = 0
  for provider_vendor in provider_vendor_list
    if provider_vendor != blank
      assign provider_vendor_count = provider_vendor_count | plus: 1
    endif
  endfor
  assign provider_columns = columns | default: provider_vendor_count
  assign directory_heading = heading
  if directory_heading == blank
    assign directory_heading = 'Proveedores disponibles para ' | append: collection.title
  endif

  assign directory_intro = intro
  if directory_intro == blank
    assign directory_intro = 'Elige un proveedor para ver todos los productos y servicios que ofrece.'
  endif

  if provider_columns < 1
    assign provider_columns = 1
  endif
  if provider_columns > 4
    assign provider_columns = 4
  endif
-%}

{%- if show_directory and provider_vendor_count > 0 -%}
  <style>
    .provider-rating {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin-top: 0.8rem;
      font-size: 1.4rem;
      line-height: 1;
    }

    .provider-rating__stars {
      color: #f5b301;
      letter-spacing: 0.12em;
      font-size: 1.5rem;
    }

    .provider-rating__summary {
      color: rgba(var(--color-foreground), 0.72);
      font-size: 1.3rem;
    }
  </style>
  <div class="page-width">
    <div class="title-wrapper title-wrapper--no-top-margin">
      <h2 class="title inline-richtext h1">{{ directory_heading }}</h2>
    </div>
    <p>{{ directory_intro }}</p>
    <ul
      class="
        collection-list contains-card contains-card--collection
        {% if settings.card_style == 'standard' %} contains-card--standard{% endif %}
        grid grid--1-col-tablet-down grid--{{ provider_columns }}-col-desktop
      "
      role="list"
    >
      {%- for provider_vendor in provider_vendor_list -%}
        {%- if provider_vendor != blank -%}
          {%- liquid
            assign provider_product = blank
            for product in collection.products
              if product.vendor == provider_vendor
                assign provider_product = product
                break
              endif
            endfor

            assign provider_vendor_query = provider_vendor | url_param_escape
            assign provider_vendor_url = routes.collections_url | append: '/vendors?q=' | append: provider_vendor_query
            assign provider_image = provider_product.featured_image | default: collection.image
            assign provider_rating_value = '4.7'
            assign provider_rating_count = '18'
            assign provider_rating_stars = '★★★★★'
            assign provider_rating_stars = '★★★★★'

            case provider_vendor
              when 'Besos Auto Essentials'
                assign provider_rating_value = '4.8'
                assign provider_rating_count = '32'
              when 'Gracia Auto Spa'
                assign provider_rating_value = '4.9'
                assign provider_rating_count = '27'
              when 'Detail Lab BCN'
                assign provider_rating_value = '4.7'
                assign provider_rating_count = '41'
              when 'Barcelona Wash Hub'
                assign provider_rating_value = '4.6'
                assign provider_rating_count = '18'
              when 'Barcelona Laundry'
                assign provider_rating_value = '4.9'
                assign provider_rating_count = '53'
              when 'La Cochera Place'
                assign provider_rating_value = '5.0'
                assign provider_rating_count = '67'
            endcase

            capture provider_rating_markup
              echo '<div class="provider-rating">'
              echo '<span class="provider-rating__stars" aria-hidden="true">'
              echo provider_rating_stars
              echo '</span>'
              echo '<span class="provider-rating__summary">'
              echo provider_rating_value
              echo ' · '
              echo provider_rating_count
              echo ' valoraciones'
              echo '</span>'
              echo '</div>'
            endcapture
          -%}
          <li class="collection-list__item grid__item">
            {% render 'card-collection',
              card_collection: collection,
              media_aspect_ratio: image_ratio | default: 'adapt',
              columns: provider_columns,
              card_title: provider_vendor,
              card_image: provider_image,
              card_url: provider_vendor_url,
              card_meta: provider_rating_markup
            %}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{%- if show_directory -%}
  <section
    class="chiclayo-provider-directory page-width"
    data-chiclayo-provider-directory
    data-service-handle="{{ collection.handle | escape }}"
    hidden
  >
    <style>
      .chiclayo-provider-directory { margin-top: 4rem; }
      .chiclayo-provider-directory__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr)); gap: 1.6rem; padding: 0; list-style: none; }
      .chiclayo-provider-card { height: 100%; padding: 2rem; border: .1rem solid rgba(var(--color-foreground), .12); border-radius: 1.2rem; background: rgb(var(--color-background)); box-shadow: 0 .6rem 1.8rem rgba(var(--color-foreground), .08); }
      .chiclayo-provider-card__head { display: flex; align-items: center; gap: 1.2rem; }
      .chiclayo-provider-card__placeholder { display: grid; flex: 0 0 5.6rem; width: 5.6rem; height: 5.6rem; place-items: center; border-radius: 50%; color: #fff; background: #07366b; }
      .chiclayo-provider-card__placeholder svg { width: 3rem; height: 3rem; }
      .chiclayo-provider-card h3 { margin: 0; font-size: 1.8rem; }
      .chiclayo-provider-card p { margin: .8rem 0 0; }
      .chiclayo-provider-card__location { color: rgba(var(--color-foreground), .72); font-size: 1.4rem; }
      .chiclayo-provider-card__status { display: inline-block; margin-top: 1.2rem; padding: .4rem .9rem; border-radius: 999px; color: #704800; background: #fff0c2; font-size: 1.2rem; font-weight: 700; }
    </style>
    <div class="title-wrapper title-wrapper--no-top-margin">
      <h2 class="title inline-richtext h1">Proveedores en Chiclayo</h2>
    </div>
    <p>Proveedores disponibles en Chiclayo, Lambayeque. Sus catálogos e imágenes se incorporarán progresivamente.</p>
    <p data-chiclayo-provider-status>Cargando proveedores…</p>
    <ul class="chiclayo-provider-directory__grid" data-chiclayo-provider-grid role="list"></ul>
  </section>

  <script>
    (() => {
      const root = document.querySelector('[data-chiclayo-provider-directory][data-service-handle="{{ collection.handle | escape }}"]');
      if (!root || new URLSearchParams(window.location.search).get('region') !== 'chiclayo') return;
      const grid = root.querySelector('[data-chiclayo-provider-grid]');
      const status = root.querySelector('[data-chiclayo-provider-status]');
      const showAllProviders = new URLSearchParams(window.location.search).get('all_providers') === '1';
      const endpoint = showAllProviders
        ? '/apps/provider-applications/providers-nearby'
        : `/apps/provider-applications/providers-nearby?service_handle=${encodeURIComponent(root.dataset.serviceHandle)}`;
      const icon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 10.5A3.5 3.5 0 1 1 12 5a3.5 3.5 0 0 1 0 7.5Z"/></svg>';
      const escapeHtml = (value) => { const node = document.createElement('span'); node.textContent = value || ''; return node.innerHTML; };

      root.hidden = false;
      fetch(endpoint, { headers: { Accept: 'application/json' } })
        .then((response) => { if (!response.ok) throw new Error(`HTTP ${response.status}`); return response.json(); })
        .then((payload) => {
          const providers = (payload.providers || []).filter((provider) => /Lambayeque,\s*Perú/i.test(provider.address || ''));
          if (!providers.length) { status.textContent = 'No hay proveedores de Chiclayo disponibles para esta categoría.'; return; }
          grid.innerHTML = providers.map((provider) => `
            <li>
              <article class="chiclayo-provider-card">
                <div class="chiclayo-provider-card__head">
                  <span class="chiclayo-provider-card__placeholder">${icon}</span>
                  <h3>${escapeHtml(provider.name)}</h3>
                </div>
                <p class="chiclayo-provider-card__location">${escapeHtml(provider.address)}</p>
                <span class="chiclayo-provider-card__status">Catálogo próximamente</span>
              </article>
            </li>`).join('');
          status.textContent = `${providers.length} proveedor${providers.length === 1 ? '' : 'es'} disponible${providers.length === 1 ? '' : 's'}`;
        })
        .catch(() => { status.textContent = 'No se pudo cargar el directorio de Chiclayo. Inténtalo de nuevo.'; });
    })();
  </script>
{%- endif -%}
